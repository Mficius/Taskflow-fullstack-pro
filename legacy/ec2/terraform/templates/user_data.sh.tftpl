#!/bin/bash
# Bootstrap de l'instance TaskFlow (Amazon Linux 2023) — exécuté une seule fois au premier boot.
set -euxo pipefail

dnf install -y docker jq xfsprogs
systemctl enable --now docker

# Plugin Docker Compose v2
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.32.4/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# Rotation des logs Docker
cat > /etc/docker/daemon.json <<'JSON'
{ "log-driver": "json-file", "log-opts": { "max-size": "10m", "max-file": "3" } }
JSON
systemctl restart docker

# Paramètres d'instance lus par scripts/deploy.sh
mkdir -p /etc/taskflow /opt/taskflow
cat > /etc/taskflow/instance.env <<'ENV'
AWS_REGION=${region}
AWS_DEFAULT_REGION=${region}
SSM_PREFIX=${ssm_prefix}
ECR_REGISTRY=${ecr_registry}
DEPLOY_BUCKET=${deploy_bkt}
APP_URL=${app_url}
ENV
chmod 644 /etc/taskflow/instance.env

# Montage du volume de données persistant (EBS chiffré)
DEV=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${data_vol_id}
for i in $(seq 1 60); do [ -e "$DEV" ] && break; sleep 5; done
[ -e "$DEV" ] || { echo "Volume de données introuvable" >&2; exit 1; }
blkid "$DEV" || mkfs.xfs "$DEV"
mkdir -p /data
UUID=$(blkid -s UUID -o value "$DEV")
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID /data xfs defaults,nofail 0 2" >> /etc/fstab
mount -a

mkdir -p /data/mysql /data/prometheus /data/grafana
chown 65534:65534 /data/prometheus   # utilisateur nobody (Prometheus)
chown 472:472 /data/grafana          # utilisateur grafana

echo "Bootstrap terminé"
