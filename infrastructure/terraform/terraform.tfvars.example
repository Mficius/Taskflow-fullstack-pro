aws_region = "eu-west-3"

github_owner = "Mficius"
github_repo  = "taskflow"

# true  = démonstration/portfolio : tout se détruit proprement (make demo-down)
# false = production : protection contre la suppression, snapshot final RDS, ECR conservé
demo_mode = true

