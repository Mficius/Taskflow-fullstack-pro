APP_NAME=TaskFlow
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# php artisan key:generate
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=mysql-db
DB_PORT=3306
DB_DATABASE=todo_db
# Ne jamais utiliser root : l'utilisateur est créé par docker-compose (voir ../.env.example)
DB_USERNAME=taskflow
DB_PASSWORD=change-this-local-app-password

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
SANCTUM_EXPIRATION_MINUTES=480
LOG_CHANNEL=stderr
